datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  holdings           Holding[]
  fireProfile        FireProfile?
  healthProfile      HealthProfile?
  healthScoreHistory HealthScoreHistory[]
  goals              Goal[]
  gamification       Gamification?
  taxProfile         TaxProfile?
  refreshTokens      RefreshToken[]
  netWorthSnapshots  NetWorthSnapshot[]
  incomeRecords      IncomeRecord[]
  expenseRecords     ExpenseRecord[]
  preferences        UserPreferences?
  trades             Trade[]
  positionLtps       PositionLtp[]
  tradeSignals       TradeSignal[]
  vcpSignals         VCPSignal[]
  tradeUploads       TradeUpload[]
  tradeRecords       TradeRecord[]
  dividendRecords    DividendRecord[]
  agtsCharges        AgtsCharge[]
  stockHoldings      StockHolding[]
  realizedPnlRecords RealizedPnlRecord[]
  brokerHoldings     BrokerHolding[]
  equityHoldings     EquityHolding[]
  mutualFundHoldings MutualFundHolding[]
  factorScorecardUploads FactorScorecardUpload[]
  factorScorecardEntries FactorScorecardEntry[]
  factorScorecardFundamentalsUploads FactorScorecardFundamentalsUpload[]
  factorScorecardFundamentals        FactorScorecardFundamental[]
  factorScorecardRuns                FactorScorecardRun[]
  factorScorecardModelScores         FactorScorecardModelScore[]

  @@index([email])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Holding {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  assetClass    AssetClass
  currentValue  BigInt // paise
  investedValue BigInt // paise
  units         Float?
  nav           Float?
  notes         String?    @db.Text
  deletedAt     DateTime?
  lastUpdated   DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([assetClass])
}

model FireProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentAge            Int
  retirementAge         Int      @default(45)
  lifeExpectancy        Int      @default(90)
  currentMonthlyExpense Int // paise
  medicalMonthlyExpense Int // paise
  lifestyleBuffer       Float    @default(0)
  expectedReturnPre     Float    @default(12)
  expectedReturnPost    Float    @default(8)
  // Extended inputs (Phase 2 enhancement)
  generalInflation      Float    @default(6)
  medicalInflation      Float    @default(10)
  withdrawalRate        Float    @default(3.5)
  expenseCategories     Json?
  incomeInputs          Json?
  assetAllocation       Json?
  liabilities           Json?
  npsInputs             Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model HealthProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyIncome      Int // paise
  monthlyExpenses    Int // paise
  monthlyEMIs        Int // paise
  liquidAssets       Int // paise
  totalLiabilities   Int // paise
  monthlySavings     Int // paise
  hasTermInsurance   Boolean  @default(false)
  hasHealthInsurance Boolean  @default(false)
  hasWill            Boolean  @default(false)
  hasNominations     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Goal {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  category          GoalCategory
  targetAmount      Int // paise
  targetYear        Int
  currentAllocation Int // paise
  inflationRate     Float        @default(6)
  notes             String?      @db.Text
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
}

model Gamification {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges          Json // Badge[]
  streakDays      Int      @default(0)
  lastVisitDate   String
  dismissedNudges Json     @default("[]") // string[]
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([userId])
}

model TaxProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  realizedGainsFY       Int      @default(0) // paise
  unrealizedEquityGains Int      @default(0) // paise
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model NetWorthSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  valueInPaise BigInt
  snapshotDate String // YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, snapshotDate])
  @@index([userId])
}

model HealthScoreHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int
  snapshotDate String // YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, snapshotDate])
  @@index([userId])
}

model IncomeRecord {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      String
  amountPaise Int
  category    IncomeCategory
  date        String // YYYY-MM-DD
  recurring   Boolean            @default(false)
  frequency   RecurringFrequency @default(ONE_TIME)
  notes       String?            @db.Text
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, date])
  @@index([category])
}

enum IncomeCategory {
  SALARY
  FREELANCE
  RENTAL
  DIVIDEND
  BUSINESS
  INTEREST
  OTHER
}

enum RecurringFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum AssetClass {
  MF
  NPS
  EPF
  PPF
  STOCK
  BANK
  LIQUID
  FD
  BOND
  ETF
  GOLD
  REAL_ESTATE
  ANNUITY
  INTL_EQUITY
  INTL_DEBT
  COMMODITY
}

enum GoalCategory {
  FIRE
  EDUCATION
  WEDDING
  PARENTS
  HOUSING
  OTHER
}

model ExpenseRecord {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant     String
  amountPaise  Int
  expenseType  ExpenseType
  category     ExpenseCategory
  date         String // YYYY-MM-DD
  recurring    Boolean         @default(false)
  notes        String?         @db.Text
  importedFrom ImportSource?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, date])
  @@index([expenseType])
  @@index([category])
}

enum ExpenseType {
  FIXED
  DISCRETIONARY
  LOAN
}

enum ExpenseCategory {
  // Fixed
  RENT
  ELECTRICITY
  WATER
  GAS
  INTERNET
  GROCERY
  COOK
  DRIVER
  MAID
  INSURANCE
  SUBSCRIPTIONS
  FIXED_OTHER
  // Discretionary
  FOOD
  TRANSPORT
  HEALTHCARE
  ENTERTAINMENT
  SHOPPING
  EDUCATION
  TRAVEL
  INVESTMENT
  DISC_OTHER
  // Loan
  HOME_LOAN_EMI
  CAR_LOAN_EMI
  PERSONAL_LOAN_EMI
  EDUCATION_LOAN_EMI
  CREDIT_CARD_EMI
  LOAN_OTHER
}

enum ImportSource {
  MANUAL
  CSV
}

model UserPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseViewMonth String? // YYYY-MM
  incomeViewMonth  String? // YYYY-MM
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model Trade {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String
  exchange       Exchange
  segment        Segment
  tradeType      TradeType
  quantity       Int
  pricePaise     Int
  date           String // YYYY-MM-DD
  brokeragePaise Int         @default(0)
  notes          String?     @db.Text
  broker         String? // KITE | GROWW | ANGELONE | HDFC_SKY | null
  importedFrom   TradeSource @default(MANUAL)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, symbol])
  @@index([userId, date])
  @@index([segment])
}

model PositionLtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  ltpPaise  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
}

enum Exchange {
  NSE
  BSE
}

enum Segment {
  EQ
  FO
  CDS
  MF
}

enum TradeType {
  BUY
  SELL
}

enum TradeSource {
  MANUAL
  KITE
  GROWW
}

model TradeSignal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD
  broker      String // KITE | GROWW
  signals     Json // StockSignal[]
  generatedAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model VCPSignal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD
  signals     Json // VCPStockSignal[]
  generatedAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

model TradeUpload {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName        String
  uploadType      String // TRADEBOOK_CSV | AGTS_XLSX | DIVIDEND_XLSX
  periodFrom      String?
  periodTo        String?
  createdAt       DateTime         @default(now())
  tradeRecords    TradeRecord[]
  dividendRecords DividendRecord[]
  agtsCharges     AgtsCharge[]

  @@index([userId])
}

model TradeRecord {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId      String
  upload        TradeUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  symbol        String
  isin          String?
  tradeDate     String
  exchange      String
  segment       String      @default("EQ")
  tradeType     String
  quantity      Float
  price         Float
  tradeId       String
  orderId       String?
  executionTime String?
  createdAt     DateTime    @default(now())

  @@unique([userId, tradeId])
  @@index([userId])
  @@index([userId, tradeDate])
  @@index([userId, symbol])
}

model DividendRecord {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId         String?
  upload           TradeUpload? @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  broker           String? // ZERODHA | GROWW | HDFC | ANGEL — null = legacy tradebook
  symbol           String
  isin             String
  exDate           String
  quantity         Float
  dividendPerShare Float
  netAmount        Float
  createdAt        DateTime     @default(now())

  @@unique([userId, broker, isin, exDate])
  @@index([userId])
  @@index([userId, exDate])
  @@index([userId, broker])
}

model AgtsCharge {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId    String?
  upload      TradeUpload? @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  broker      String? // ZERODHA | GROWW | HDFC | ANGEL — null = legacy tradebook
  periodFrom  String
  periodTo    String
  accountHead String
  amount      Float
  createdAt   DateTime     @default(now())

  @@unique([userId, broker, periodFrom, periodTo, accountHead])
  @@index([userId])
  @@index([userId, broker])
}

model StockHolding {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol            String
  isin              String
  sector            String
  quantityAvailable Float
  quantityLongTerm  Float    @default(0)
  avgPrice          Float
  currentPrice      Float
  unrealizedPnl     Float
  unrealizedPnlPct  Float
  asOfDate          String // YYYY-MM-DD
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, symbol, isin, asOfDate])
  @@index([userId])
  @@index([userId, asOfDate])
}

model RealizedPnlRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker        String? // ZERODHA | GROWW | HDFC | ANGEL — null = legacy tradebook
  symbol        String
  isin          String
  entryDate     String
  exitDate      String
  quantity      Float
  buyValue      Float
  sellValue     Float
  profit        Float
  holdingType   String // STCG | LTCG | INTRADAY | NON_EQ_STCG | NON_EQ_LTCG
  taxableProfit Float
  tradeCharges  Float    @default(0) // consolidated per-trade charges (STT + brokerage + taxes)
  periodFrom    String
  periodTo      String
  createdAt     DateTime @default(now())

  @@unique([userId, broker, symbol, isin, entryDate, exitDate, holdingType, quantity])
  @@index([userId])
  @@index([userId, broker])
  @@index([userId, exitDate])
}

model BrokerHolding {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker            String // ZERODHA | GROWW | HDFC | ANGEL
  symbol            String
  isin              String
  sector            String   @default("")
  quantityAvailable Float
  quantityLongTerm  Float    @default(0)
  avgPrice          Float
  currentPrice      Float
  unrealizedPnl     Float
  unrealizedPnlPct  Float
  asOfDate          String // YYYY-MM-DD
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, broker, isin, asOfDate])
  @@index([userId, broker])
  @@index([userId, broker, asOfDate])
}

// Consolidated equity holdings uploaded from a Tickertape (or similar
// cross-broker aggregator) CSV export — one row per symbol per snapshot date,
// enriched with sector/industry from the bundled instrument master so the UI
// never needs to re-look these up.
model EquityHolding {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol             String
  companyName        String   @default("")
  sector             String   @default("Uncategorized")
  industry           String   @default("Uncategorized")
  quantity           Float
  avgCost            Float
  ltp                Float
  investedValue      Float
  currentValue       Float
  pnl                Float
  pnlPct             Float
  portfolioWeightPct Float    @default(0)
  dayChange          Float    @default(0)
  dayChangePct       Float    @default(0)
  asOfDate           String // YYYY-MM-DD
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, symbol, asOfDate])
  @@index([userId])
  @@index([userId, asOfDate])
}

// Mutual fund holdings uploaded from a Tickertape (or similar cross-broker
// aggregator) CSV export — one row per fund per snapshot date.
model MutualFundHolding {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundName      String
  amcName       String   @default("")
  category      String   @default("")
  subCategory   String   @default("")
  planType      String   @default("")
  optionType    String   @default("")
  nav           Float
  units         Float
  investedValue Float
  currentValue  Float
  weightPct     Float    @default(0)
  pnl           Float
  pnlPct        Float
  xirrPct       Float    @default(0)
  investedSince String   @default("") // YYYY-MM-DD
  asOfDate      String // YYYY-MM-DD
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, fundName, asOfDate])
  @@index([userId])
  @@index([userId, asOfDate])
}

model FactorScorecardUpload {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  universe  String // NIFTY100 | NIFTY_MIDCAP150
  runDate   String // YYYY-MM-DD — date the scorecard was run, user-supplied at upload
  source    String                 @default("MANUAL_XLSX") // MANUAL_XLSX | AI_GENERATED
  createdAt DateTime               @default(now())
  entries   FactorScorecardEntry[]

  @@unique([userId, universe, runDate])
  @@index([userId])
}

model FactorScorecardEntry {
  id             String                       @id @default(cuid())
  userId         String
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId       String
  upload         FactorScorecardUpload        @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  universe       String // NIFTY100 | NIFTY_MIDCAP150
  runDate        String // YYYY-MM-DD
  rank           Int
  ticker         String
  sector         String
  cmp            Float
  f1             Float
  f2             Float
  f3             Float
  f4             Float
  f5             Float
  f6             Float
  f7             Float
  f8             Float
  f9             Float
  f10            Float
  score          Float
  recommendation String
  reasoning      Json // { moat, financial, growth, valuation, mgmt, earnings, macro, risk, dividend, liquidity }
  createdAt      DateTime                     @default(now())
  modelScores    FactorScorecardModelScore[]

  @@unique([userId, universe, runDate, ticker])
  @@index([userId])
  @@index([userId, universe])
  @@index([userId, runDate])
}

model FactorScorecardFundamentalsUpload {
  id        String                       @id @default(cuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  universe  String // NIFTY100 | NIFTY_MIDCAP150
  runDate   String // YYYY-MM-DD
  createdAt DateTime                     @default(now())
  rows      FactorScorecardFundamental[]
  runs      FactorScorecardRun[]

  @@unique([userId, universe, runDate])
  @@index([userId])
}

model FactorScorecardFundamental {
  id                 String                            @id @default(cuid())
  userId             String
  user               User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadId           String
  upload             FactorScorecardFundamentalsUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  ticker             String
  sector             String
  cmp                Float
  pe                 Float?
  pb                 Float?
  roe                Float?
  roce               Float?
  debtToEquity       Float?
  revenueCagr3yr     Float?
  profitCagr3yr      Float?
  dividendYieldPct   Float?
  payoutPct          Float?
  promoterHoldingPct Float?
  fiiDiiHoldingPct   Float?
  beta               Float?
  notes              String?                           @db.Text
  createdAt          DateTime                          @default(now())

  @@unique([uploadId, ticker])
  @@index([userId])
}

model FactorScorecardRun {
  id                   String                            @id @default(cuid())
  userId               String
  user                 User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundamentalsUploadId String
  fundamentalsUpload   FactorScorecardFundamentalsUpload @relation(fields: [fundamentalsUploadId], references: [id], onDelete: Cascade)
  universe             String
  runDate              String
  status               String                            @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  batchesTotal         Int                               @default(0)
  batchesDone          Int                               @default(0)
  resultUploadId       String?
  error                String?                           @db.Text
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt

  @@index([userId])
}

model FactorScorecardModelScore {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId   String
  entry     FactorScorecardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  provider  String // OPENAI | GEMINI | CLAUDE
  f1        Float
  f2        Float
  f3        Float
  f4        Float
  f5        Float
  f6        Float
  f7        Float
  f8        Float
  f9        Float
  f10       Float
  score     Float
  reasoning Json
  createdAt DateTime             @default(now())

  @@unique([entryId, provider])
  @@index([userId])
}

