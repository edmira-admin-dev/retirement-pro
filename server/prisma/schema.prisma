datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  holdings           Holding[]
  fireProfile        FireProfile?
  healthProfile      HealthProfile?
  healthScoreHistory HealthScoreHistory[]
  goals              Goal[]
  gamification       Gamification?
  taxProfile         TaxProfile?
  refreshTokens      RefreshToken[]
  netWorthSnapshots  NetWorthSnapshot[]
  incomeRecords      IncomeRecord[]
  expenseRecords     ExpenseRecord[]
  preferences        UserPreferences?
  trades             Trade[]
  positionLtps       PositionLtp[]
  brokerConnections  BrokerConnection[]

  @@index([email])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Holding {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  assetClass    AssetClass
  currentValue  BigInt    // paise
  investedValue BigInt    // paise
  units         Float?
  nav           Float?
  notes         String?   @db.Text
  deletedAt     DateTime?
  lastUpdated   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([assetClass])
}

model FireProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentAge            Int
  retirementAge         Int      @default(45)
  lifeExpectancy        Int      @default(90)
  currentMonthlyExpense Int      // paise
  medicalMonthlyExpense Int      // paise
  lifestyleBuffer       Float    @default(0)
  expectedReturnPre     Float    @default(12)
  expectedReturnPost    Float    @default(8)
  // Extended inputs (Phase 2 enhancement)
  generalInflation      Float    @default(6)
  medicalInflation      Float    @default(10)
  withdrawalRate        Float    @default(3.5)
  expenseCategories     Json?
  incomeInputs          Json?
  assetAllocation       Json?
  liabilities           Json?
  npsInputs             Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model HealthProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyIncome      Int      // paise
  monthlyExpenses    Int      // paise
  monthlyEMIs        Int      // paise
  liquidAssets       Int      // paise
  totalLiabilities   Int      // paise
  monthlySavings     Int      // paise
  hasTermInsurance   Boolean  @default(false)
  hasHealthInsurance Boolean  @default(false)
  hasWill            Boolean  @default(false)
  hasNominations     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Goal {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  category          GoalCategory
  targetAmount      Int          // paise
  targetYear        Int
  currentAllocation Int          // paise
  inflationRate     Float        @default(6)
  notes             String?      @db.Text
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
}

model Gamification {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges          Json     // Badge[]
  streakDays      Int      @default(0)
  lastVisitDate   String
  dismissedNudges Json     @default("[]") // string[]
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([userId])
}

model TaxProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  realizedGainsFY       Int      @default(0) // paise
  unrealizedEquityGains Int      @default(0) // paise
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model NetWorthSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  valueInPaise BigInt
  snapshotDate String   // YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, snapshotDate])
  @@index([userId])
}

model HealthScoreHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int
  snapshotDate String   // YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, snapshotDate])
  @@index([userId])
}

model IncomeRecord {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      String
  amountPaise Int
  category    IncomeCategory
  date        String            // YYYY-MM-DD
  recurring   Boolean           @default(false)
  frequency   RecurringFrequency @default(ONE_TIME)
  notes       String?           @db.Text
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, date])
  @@index([category])
}

enum IncomeCategory {
  SALARY
  FREELANCE
  RENTAL
  DIVIDEND
  BUSINESS
  INTEREST
  OTHER
}

enum RecurringFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum AssetClass {
  MF
  NPS
  EPF
  PPF
  STOCK
  BANK
  LIQUID
  FD
  BOND
  ETF
  GOLD
  REAL_ESTATE
  ANNUITY
  INTL_EQUITY
  INTL_DEBT
  COMMODITY
}

enum GoalCategory {
  FIRE
  EDUCATION
  WEDDING
  PARENTS
  HOUSING
  OTHER
}

model ExpenseRecord {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant     String
  amountPaise  Int
  expenseType  ExpenseType
  category     ExpenseCategory
  date         String          // YYYY-MM-DD
  recurring    Boolean         @default(false)
  notes        String?         @db.Text
  importedFrom ImportSource?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, date])
  @@index([expenseType])
  @@index([category])
}

enum ExpenseType {
  FIXED
  DISCRETIONARY
  LOAN
}

enum ExpenseCategory {
  // Fixed
  RENT
  ELECTRICITY
  WATER
  GAS
  INTERNET
  GROCERY
  COOK
  DRIVER
  MAID
  INSURANCE
  SUBSCRIPTIONS
  FIXED_OTHER
  // Discretionary
  FOOD
  TRANSPORT
  HEALTHCARE
  ENTERTAINMENT
  SHOPPING
  EDUCATION
  TRAVEL
  INVESTMENT
  DISC_OTHER
  // Loan
  HOME_LOAN_EMI
  CAR_LOAN_EMI
  PERSONAL_LOAN_EMI
  EDUCATION_LOAN_EMI
  CREDIT_CARD_EMI
  LOAN_OTHER
}

enum ImportSource {
  MANUAL
  CSV
}

model UserPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseViewMonth String?  // YYYY-MM
  incomeViewMonth  String?  // YYYY-MM
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model Trade {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String
  exchange       Exchange
  segment        Segment
  tradeType      TradeType
  quantity       Int
  pricePaise     Int
  date           String       // YYYY-MM-DD
  brokeragePaise Int          @default(0)
  notes          String?      @db.Text
  broker         String?      // KITE | GROWW | ANGELONE | HDFC_SKY | null
  importedFrom   TradeSource  @default(MANUAL)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, symbol])
  @@index([userId, date])
  @@index([segment])
}

model PositionLtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  ltpPaise  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
}

enum Exchange {
  NSE
  BSE
}

enum Segment {
  EQ
  FO
  CDS
  MF
}

enum TradeType {
  BUY
  SELL
}

enum TradeSource {
  MANUAL
  KITE
  GROWW
}

model BrokerConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker            String    // KITE | GROWW | ANGELONE | HDFC_SKY
  connectionType    String    // API | CSV
  status            String    @default("DISCONNECTED")
  credentialsJson   String?   @db.Text
  lastSyncedAt      DateTime?
  errorMessage      String?
  tradesSynced      Int       @default(0)
  duplicatesSkipped Int       @default(0)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, broker])
  @@index([userId])
  @@index([userId, deletedAt])
}
